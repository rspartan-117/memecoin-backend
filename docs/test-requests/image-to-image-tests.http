###############################################################################
# Test 10: Maximum Quality Settings
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/flux-2/edit",
  "params": {
    "prompt": "Ultra high quality, professional remaster, perfect details, 8K quality, museum-grade photography",
    "image_urls": ["{{sampleImage}}"],
    "strength": 0.7,
    "guidance_scale": 8.0,
    "num_inference_steps": 50,
    "output_format": "png",
    "enable_safety_checker": true
  },
  "waitForCompletion": true,
  "timeoutMs": 180000
}

