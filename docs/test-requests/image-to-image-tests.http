### Image-to-Image API Tests
### Base URL: http://localhost:4000/generation
### Auth Token: test-token
### IMPORTANT: Replace example image URLs with real accessible URLs

@baseUrl = http://localhost:4000/generation
@authToken = test-token
@sampleImage = https://example.com/sample-photo.jpg

###############################################################################
# Test 1: Watercolor Style Transfer (Fast, 1 credit)
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/nano-banana/edit",
  "params": {
    "prompt": "Watercolor painting style, soft pastel colors, artistic brush strokes",
    "image_urls": ["{{sampleImage}}"],
    "strength": 0.65,
    "num_inference_steps": 20,
    "guidance_scale": 3.5
  },
  "waitForCompletion": true,
  "timeoutMs": 60000
}

###############################################################################
# Test 2: Premium Quality Enhancement (Fast Premium, 2 credits)
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/nano-banana-pro/edit",
  "params": {
    "prompt": "Professional photography, enhanced details, perfect lighting, premium quality, sharp focus, vivid colors",
    "image_urls": ["{{sampleImage}}"],
    "strength": 0.45,
    "guidance_scale": 5.0,
    "num_inference_steps": 30,
    "output_format": "jpeg"
  },
  "waitForCompletion": true,
  "timeoutMs": 90000
}

###############################################################################
# Test 3: Advanced Transformation with flux-2/edit (Premium, 2 credits)
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/flux-2/edit",
  "params": {
    "prompt": "Cyberpunk neon aesthetic, purple and blue tones, futuristic city background at night, neon lights, rain reflections",
    "image_urls": ["{{sampleImage}}"],
    "strength": 0.8,
    "aspect_ratio": "16:9",
    "guidance_scale": 6.0,
    "num_inference_steps": 35
  },
  "waitForCompletion": true,
  "timeoutMs": 120000
}

