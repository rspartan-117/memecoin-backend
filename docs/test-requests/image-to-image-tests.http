###############################################################################
# Test 8: Reproducible Edit with Seed
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/nano-banana/edit",
  "params": {
    "prompt": "Vintage film look, faded colors, nostalgic aesthetic, film grain",
    "image_urls": ["{{sampleImage}}"],
    "strength": 0.55,
    "num_inference_steps": 20,
    "seed": 98765
  },
  "waitForCompletion": true,
  "timeoutMs": 60000
}

###
# NOTE: Run this request twice with same seed to verify reproducibility

