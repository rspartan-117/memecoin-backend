###############################################################################
# Test 13: Error Test - Missing Required Field (image_urls)
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/nano-banana/edit",
  "params": {
    "prompt": "Test transformation"
  }
}

###
# Expected: 400 Bad Request with "params.image_urls should not be empty"

###############################################################################
# Test 14: Error Test - Invalid Strength Value
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/nano-banana/edit",
  "params": {
    "prompt": "Test transformation",
    "image_urls": ["{{sampleImage}}"],
    "strength": 1.5
  }
}

###
# Expected: 400 Bad Request with "params.strength must not be greater than 1"

###############################################################################
# Test 15: Error Test - Empty image_urls Array
###############################################################################

POST {{baseUrl}}/image-to-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "modelName": "fal-ai/nano-banana/edit",
  "params": {
    "prompt": "Test transformation",
    "image_urls": []
  }
}

###
# Expected: 400 Bad Request validation error

